#!/usr/bin/env bash
# Copy this file to storage.env, then replace the two placeholder paths.
# Never commit storage.env or a Hugging Face token.

: "${VAULTGEMMA_CODE_ROOT:?This file must be sourced by run_vaultgemma_vectorized.sh}"

export AI_SAFETY_PROJECT_ROOT="${VAULTGEMMA_CODE_ROOT}"
export AI_SAFETY_RAID_ROOT="/path/to/large-storage/vaultgemma"

export HF_HOME="${AI_SAFETY_RAID_ROOT}/cache/huggingface"
export HF_HUB_CACHE="${HF_HOME}/hub"
export HF_DATASETS_CACHE="${HF_HOME}/datasets"
export HF_XET_CACHE="${HF_HOME}/xet"
export TORCH_HOME="${AI_SAFETY_RAID_ROOT}/cache/torch"
export TMPDIR="${AI_SAFETY_RAID_ROOT}/tmp"

# Hugging Face reads its token from the standard user cache or HF_TOKEN.
# Do not place a token value in this file.

export AI_SAFETY_CHECKPOINT_DIR="${AI_SAFETY_RAID_ROOT}/checkpoints"
export AI_SAFETY_RUN_DIR="${AI_SAFETY_RAID_ROOT}/runs"
